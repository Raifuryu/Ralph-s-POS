TZ=Asia/Manila

# Copy to .env.local and fill in. Used both for `pnpm dev` (against a
# MariaDB instance you already have running) and for `docker compose up`
# (docker-compose.yml loads this same file — one source of truth for both).

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=ralph_pos

# Signs/verifies the login session cookie (HMAC) — generate a real random
# value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session.
SESSION_SECRET=
