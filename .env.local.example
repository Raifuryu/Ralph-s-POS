# Copy to .env.local and fill in. Used both for `pnpm dev` (against a
# MariaDB instance you already have running) and for `docker compose up`
# (docker-compose.yml loads this same file — one source of truth for both).

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=ralph_pos

# Docker only: password for the db container's root account, used to
# bootstrap it on first boot. The app itself never connects as root — it
# uses MARIADB_USER/MARIADB_PASSWORD above. Ignored by `pnpm dev`.
# NOTE: if MARIADB_USER above is "root", the official mariadb image won't
# create a separate app user — root's real password becomes
# MARIADB_ROOT_PASSWORD, so MARIADB_PASSWORD must then match it exactly, or
# app<->db auth will fail inside Docker. Simplest fix: use a non-root
# MARIADB_USER (e.g. "ralph") so this doesn't come up.
MARIADB_ROOT_PASSWORD=

# Signs/verifies the login session cookie (HMAC) — generate a real random
# value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session.
SESSION_SECRET=
